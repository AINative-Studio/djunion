# DJ Union - Environment Variables Template
# Copy this file to .env and update with your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL="postgresql://djunion:dev_password@localhost:5432/djunion_dev?schema=public"

# For production, use connection pooling:
# DATABASE_URL="postgresql://user:password@host:5432/djunion?pgbouncer=true&connection_limit=20"

# Direct database URL for migrations (bypasses connection pooling)
DIRECT_DATABASE_URL="postgresql://djunion:dev_password@localhost:5432/djunion_dev"

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration (RS256)
JWT_PRIVATE_KEY_PATH="./keys/jwt_private.pem"
JWT_PUBLIC_KEY_PATH="./keys/jwt_public.pem"
JWT_ACCESS_TOKEN_EXPIRY="15m"
JWT_REFRESH_TOKEN_EXPIRY="30d"

# Password Hashing
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_SECRET="change-this-to-a-random-256-bit-secret-in-production"

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# Redis Key Prefixes
REDIS_PREFIX_HEARTBEAT="heartbeat:"
REDIS_PREFIX_CACHE="cache:"
REDIS_PREFIX_RATELIMIT="rl:"
REDIS_PREFIX_QUEUE="queue:"

# TTL Configuration (seconds)
REDIS_TTL_HEARTBEAT=300
REDIS_TTL_RSS_FEED=300
REDIS_TTL_ANALYTICS=3600

# ============================================================================
# OBJECT STORAGE (S3 / MinIO)
# ============================================================================

# For local development with MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="djunion-dev"
S3_REGION="us-east-1"

# For production with AWS S3
# S3_ENDPOINT="" (leave empty for AWS S3)
# S3_ACCESS_KEY="your-aws-access-key"
# S3_SECRET_KEY="your-aws-secret-key"
# S3_BUCKET="djunion-production"
# S3_REGION="us-east-1"

# CloudFront CDN (optional)
CDN_URL="https://cdn.djunion.com"

# ============================================================================
# KUBERNETES CONFIGURATION
# ============================================================================
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE="audio-api-staging"
KUBERNETES_CONFIG_PATH="~/.kube/config"

# Relay Worker Configuration
RELAY_WORKER_IMAGE="djunion/relay-worker:latest"
RELAY_WORKER_MEMORY_LIMIT="256Mi"
RELAY_WORKER_CPU_LIMIT="500m"

# ============================================================================
# STRIPE INTEGRATION
# ============================================================================
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_API_VERSION="2023-10-16"

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@djunion.com"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="DJ Union <noreply@djunion.com>"

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

GRAFANA_ENABLED=true
GRAFANA_PORT=3001

LOG_LEVEL="info"
LOG_FORMAT="json"

# Sentry (Error Tracking)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV="development"
PORT=3000
API_BASE_URL="http://localhost:3000/v1"
FRONTEND_URL="http://localhost:3001"

# CORS Configuration
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS_METADATA=100
RATE_LIMIT_MAX_REQUESTS_WRITE=10
RATE_LIMIT_MAX_REQUESTS_STREAM=1000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=100
ALLOWED_AUDIO_FORMATS="audio/mpeg,audio/mp3"

# ============================================================================
# FFMPEG CONFIGURATION
# ============================================================================
FFMPEG_PATH="/usr/bin/ffmpeg"
FFMPEG_HLS_TIME=6
FFMPEG_HLS_LIST_SIZE=0
FFMPEG_HLS_SEGMENT_TYPE="mpegts"
FFMPEG_AUDIO_BITRATE="128k"

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================
ANALYTICS_AGGREGATION_CRON="0 0 * * *"
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_RAW_EVENTS_RETENTION_DAYS=30

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_CUSTOM_DOMAINS=true
FEATURE_MONETIZATION=true
FEATURE_AD_INSERTION=true
FEATURE_LIVE_STREAMING=true
FEATURE_PODCASTS=true
FEATURE_ANALYTICS=true

# ============================================================================
# DEVELOPMENT / DEBUG
# ============================================================================
DEBUG=false
MOCK_STRIPE=true
MOCK_EMAIL=true
MOCK_SHOUTCAST=false
