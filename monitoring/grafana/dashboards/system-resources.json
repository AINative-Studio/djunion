{
  "dashboard": {
    "title": "DJ Union - System Resources",
    "tags": ["system", "resources", "kubernetes", "djunion"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"djunion\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "CPU Cores"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [0.8],
                "type": "gt"
              },
              "operator": { "type": "and" },
              "query": { "params": ["A", "5m", "now"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "High CPU Usage",
          "noDataState": "no_data"
        }
      },
      {
        "id": 2,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{namespace=\"djunion\"}) by (pod)",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "bytes",
            "label": "Memory"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [1073741824],
                "type": "gt"
              },
              "operator": { "type": "and" },
              "query": { "params": ["A", "5m", "now"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "High Memory Usage",
          "noDataState": "no_data"
        }
      },
      {
        "id": 3,
        "title": "Pod Count by Namespace",
        "type": "stat",
        "gridPos": { "x": 0, "y": 8, "w": 8, "h": 4 },
        "targets": [
          {
            "expr": "count(kube_pod_info{namespace=\"djunion\"})",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 4,
        "title": "Node Count",
        "type": "stat",
        "gridPos": { "x": 8, "y": 8, "w": 8, "h": 4 },
        "targets": [
          {
            "expr": "count(kube_node_info)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 5,
        "title": "Cluster CPU Capacity",
        "type": "gauge",
        "gridPos": { "x": 16, "y": 8, "w": 8, "h": 4 },
        "targets": [
          {
            "expr": "(sum(rate(container_cpu_usage_seconds_total{namespace=\"djunion\"}[5m])) / sum(kube_node_status_allocatable_cpu_cores)) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 70, "color": "yellow" },
                { "value": 85, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Network I/O",
        "type": "graph",
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"djunion\"}[5m])) by (pod)",
            "legendFormat": "RX {{pod}}",
            "refId": "A"
          },
          {
            "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"djunion\"}[5m])) by (pod)",
            "legendFormat": "TX {{pod}}",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "Bps",
            "label": "Bytes/sec"
          }
        ]
      },
      {
        "id": 7,
        "title": "Disk I/O",
        "type": "graph",
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(container_fs_reads_bytes_total{namespace=\"djunion\"}[5m])) by (pod)",
            "legendFormat": "Read {{pod}}",
            "refId": "A"
          },
          {
            "expr": "sum(rate(container_fs_writes_bytes_total{namespace=\"djunion\"}[5m])) by (pod)",
            "legendFormat": "Write {{pod}}",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "Bps",
            "label": "Bytes/sec"
          }
        ]
      },
      {
        "id": 8,
        "title": "Redis Memory Usage",
        "type": "graph",
        "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "redis_memory_usage_bytes",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "bytes",
            "label": "Memory"
          }
        ]
      },
      {
        "id": 9,
        "title": "Redis Keys Total",
        "type": "stat",
        "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "sum(redis_keys_total)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 10,
        "title": "Redis Commands/sec",
        "type": "graph",
        "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(redis_commands_total[5m])) by (command)",
            "legendFormat": "{{command}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Commands/sec"
          }
        ]
      },
      {
        "id": 11,
        "title": "PostgreSQL Connections",
        "type": "graph",
        "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"djunion\"}",
            "legendFormat": "Active Connections",
            "refId": "A"
          },
          {
            "expr": "pg_settings_max_connections",
            "legendFormat": "Max Connections",
            "refId": "B"
          }
        ]
      },
      {
        "id": 12,
        "title": "PostgreSQL Transaction Rate",
        "type": "graph",
        "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit{datname=\"djunion\"}[5m])",
            "legendFormat": "Commits",
            "refId": "A"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback{datname=\"djunion\"}[5m])",
            "legendFormat": "Rollbacks",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "tps",
            "label": "Transactions/sec"
          }
        ]
      },
      {
        "id": 13,
        "title": "S3 Request Rate",
        "type": "graph",
        "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(s3_requests_total[5m])) by (operation)",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 14,
        "title": "S3 Data Transfer",
        "type": "graph",
        "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(s3_bytes_uploaded_total[5m]))",
            "legendFormat": "Upload",
            "refId": "A"
          },
          {
            "expr": "sum(rate(s3_bytes_downloaded_total[5m]))",
            "legendFormat": "Download",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "Bps",
            "label": "Bytes/sec"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "query",
          "query": "label_values(kube_pod_info, namespace)",
          "current": {
            "text": "djunion",
            "value": "djunion"
          },
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "options": [],
          "refresh": 1
        },
        {
          "name": "pod",
          "type": "query",
          "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "hide": 0,
          "includeAll": true,
          "multi": true,
          "options": [],
          "refresh": 1
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  }
}
