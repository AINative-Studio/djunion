# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Database (Test)
DATABASE_URL=postgresql://djunion_test:test_password@localhost:5433/djunion_test

# JWT Configuration
JWT_PRIVATE_KEY_PATH=./test/keys/jwt_private_test.pem
JWT_PUBLIC_KEY_PATH=./test/keys/jwt_public_test.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# Redis (Test)
REDIS_URL=redis://localhost:6380

# S3 / MinIO (Test)
S3_ENDPOINT=http://localhost:9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=djunion-test
S3_REGION=us-east-1

# Rate Limiting
RATE_LIMIT_METADATA_MAX=100
RATE_LIMIT_METADATA_WINDOW=60000
RATE_LIMIT_WRITE_MAX=10
RATE_LIMIT_WRITE_WINDOW=60000

# Testing
TEST_TIMEOUT=10000
SUPPRESS_LOGS=true
