# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://djunion:dev_password@localhost:5432/djunion_dev

# JWT Configuration
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=djunion-dev
S3_REGION=us-east-1

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Rate Limiting
RATE_LIMIT_METADATA_MAX=100
RATE_LIMIT_METADATA_WINDOW=60000
RATE_LIMIT_WRITE_MAX=10
RATE_LIMIT_WRITE_WINDOW=60000

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000
